{
  "name": "interviewcoder-local-rebuild",
  "version": "0.1.0",
  "private": true,
  "main": "apps/desktop/main/index.cjs",
  "scripts": {
    "test": "node --test tests/**/*.test.cjs",
    "check": "node tools/check-js.cjs",
    "start": "electron .",
    "smoke": "node tools/electron-smoke.cjs",
    "build:linux": "node tools/build-linux-bundle.cjs",
    "check:linux-bundle": "node tools/check-linux-bundle.cjs",
    "build:deb": "node tools/build-linux-deb.cjs",
    "check:deb": "node tools/check-linux-deb.cjs",
    "sbom": "node tools/generate-sbom.cjs",
    "build:update": "node tools/build-update.cjs",
    "asr:fixture": "node tools/local-asr-fixture.cjs",
    "test:screen-ocr": "node --test tests/screen-ocr.test.cjs",
    "test:screen-ocr-preflight": "node --test tests/screen-ocr-preflight.test.cjs",
    "test:system-audio": "node --test tests/system-audio.test.cjs tests/system-audio-renderer.test.cjs",
    "test:asr-server": "python3 -m unittest tests/local_asr_server_test.py",
    "test:asr-runtime": "python3 -m unittest tests/asr_runtime_preflight_test.py",
    "test:asr-doctor": "python3 -m unittest tests/asr_runtime_doctor_test.py",
    "test:asr-quality": "python3 -m unittest tests/asr_quality_test.py",
    "test:asr-smoke": "python3 -m unittest tests/asr_runtime_smoke_test.py",
    "test:audio-preflight": "python3 -m unittest tests/audio_hardware_preflight_test.py",
    "asr:preflight": "python3 tools/asr_runtime_preflight.py",
    "asr:doctor": "python3 tools/asr_runtime_doctor.py",
    "asr:smoke": "python3 tools/asr_runtime_smoke.py",
    "audio:preflight": "python3 tools/audio_hardware_preflight.py",
    "ocr:preflight": "node tools/screen-ocr-preflight.cjs",
    "asr:faster-whisper": "python3 services/local-asr/faster_whisper_server.py"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "playwright-core": "1.57.0"
  },
  "engines": {
    "node": ">=24"
  }
}
